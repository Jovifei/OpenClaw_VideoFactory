    "facts": [
      {
        "fact_id": "mutex_task_ownership",
        "claim": "FreeRTOS 互斥锁包含优先级继承语义，适用于任务之间的互斥；其所有权应在任务上下文中取得并归还。",
        "source_ids": ["freertos_mutexes", "freertos_reference_manual"]
      },
      {
        "fact_id": "isr_nonblocking_boundary",
        "claim": "中断服务程序不能阻塞等待互斥锁保护的资源，ISR 应使用适合中断的同步方式通知任务继续处理。",
        "source_ids": ["freertos_mutexes", "freertos_isr_guidance"]
      },
      {
        "fact_id": "priority_inheritance_context",
        "claim": "互斥锁的优先级继承只在任务取得和释放互斥锁的上下文中有意义，不能把它当作普通中断信号量。",
        "source_ids": ["freertos_mutexes", "freertos_reference_manual"]
      },
      {
        "fact_id": "short_isr_handler",
        "claim": "ISR 应保持短小，完成必要的取数或清标志后唤醒处理任务，把共享资源访问和状态机修改留在任务上下文。",
        "source_ids": ["freertos_isr_guidance"]
      }
    ],
