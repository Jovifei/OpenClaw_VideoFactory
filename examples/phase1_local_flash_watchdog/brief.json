    "facts": [
      {
        "fact_id": "flash_erase_sequence",
        "claim": "Flash 擦除和编程必须遵循具体器件参考手册规定的解锁、操作、忙状态和错误检查顺序，不能把一次长操作当成无界等待。",
        "source_ids": ["stm32_rm0008"]
      },
      {
        "fact_id": "iwdg_independent_timeout",
        "claim": "独立看门狗使用独立低速时钟持续倒计时，在计数到期且未按器件规则处理时会触发系统复位。",
        "source_ids": ["stm32_rm0008", "stm32_wdg_overview"]
      },
      {
        "fact_id": "service_window_is_budget",
        "claim": "擦除期间能否服务看门狗取决于具体器件的执行上下文和时序限制，因此应先计算最长操作时间与服务窗口，再决定故障路径。",
        "source_ids": ["stm32_rm0008", "stm32_wdg_overview"]
      },
      {
        "fact_id": "observable_recovery",
        "claim": "长操作应分成发起、等待忙状态、检查错误和完成确认等可观察阶段，超出预算时进入明确恢复路径，而不是无限重试。",
        "source_ids": ["stm32_rm0008"]
      }
    ],
