{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/video/phase1_lifecycle_evidence.schema.json",
  "title": "Phase1LifecycleEvidence",
  "type": "object",
  "required": ["schema_version", "phase", "evidence_type", "status", "job_id", "assertions", "observed_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "phase": {"type": "string", "const": "PHASE_1_LOCAL_VIDEO_FACTORY"},
    "evidence_type": {"type": "string", "enum": ["cancel", "retry", "restart_recovery", "encoder_fallback"]},
    "status": {"type": "string", "const": "passed"},
    "job_id": {"type": "string", "pattern": "^job-[a-f0-9]{24}$"},
    "assertions": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"type": ["boolean", "string", "number", "null"]}
    },
    "observed_at": {"type": "string", "format": "date-time"}
  }
}
