{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/video/timeline.schema.json",
  "title": "Timeline",
  "description": "Render execution layer: Renderer's input contract. Produced deterministically by StoryboardCompiler from Storyboard + Registry. Contains no wall-clock timestamps — suitable for diff-based regression.",
  "type": "object",
  "required": ["schema_version", "source_storyboard_id", "registry_version", "width", "height", "fps", "transition_seconds", "total_duration_seconds", "scenes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "source_storyboard_id": {"type": "string"},
    "registry_version": {"type": "string"},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "fps": {"type": "integer", "minimum": 1},
    "transition_seconds": {"type": "number", "minimum": 0},
    "total_duration_seconds": {"type": "number", "minimum": 0},
    "composition": {"$ref": "composition.schema.json"},
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/timeline_scene"}}
  },
  "$defs": {
    "timeline_scene": {
      "type": "object",
      "required": ["order", "scene_id", "asset_id", "image", "image_path", "duration", "transition", "narration", "caption"],
      "additionalProperties": false,
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "scene_id": {"type": "string"},
        "asset_id": {"type": "string"},
        "layout_mode": {"type": "string", "enum": ["knowledge_illustration", "full_frame"]},
        "subtitle_layout": {"type": "string", "enum": ["knowledge_illustration", "bottom_safe_band", "disabled"]},
        "character_position": {"type": "string", "enum": ["left", "center", "right", "top_left", "top_right", "bottom_left", "bottom_right"]},
        "content_region": {"$ref": "#/$defs/content_region"},
        "image": {"type": "string", "description": "Bare filename (for backward compat with renderer)."},
        "image_path": {"type": "string", "description": "Repo-relative POSIX path (resolves via repo_root)."},
        "duration": {"type": "number", "minimum": 0.25},
        "transition": {"type": "string", "enum": ["fade", "zoom", "slide", "none"]},
        "narration": {"type": "string"},
        "caption": {"type": "string"}
      }
    },
    "content_region": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1080},
        "y": {"type": "number", "minimum": 0, "maximum": 1920},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1080},
        "height": {"type": "number", "exclusiveMaximum": 1921, "exclusiveMinimum": 0}
      }
    }
  }
}
