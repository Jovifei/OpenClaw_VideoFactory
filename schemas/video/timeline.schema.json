{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://openclaw.local/schemas/video/timeline.schema.json", "title": "Timeline", "description": "Render execution layer: Renderer's input contract. Produced deterministically by StoryboardCompiler from Storyboard + Registry. Contains no wall-clock timestamps — suitable for diff-based regression.", "type": "object", "required": ["schema_version", "source_storyboard_id", "registry_version", "width", "height", "fps", "transition_seconds", "total_duration_seconds", "scenes"], "additionalProperties": false, "properties": {"schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+$"}, "source_storyboard_id": {"type": "string"}, "registry_version": {"type": "string"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "fps": {"type": "integer", "minimum": 1}, "transition_seconds": {"type": "number", "minimum": 0}, "total_duration_seconds": {"type": "number", "minimum": 0}, "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/timeline_scene"}}}, "$defs": {"timeline_scene": {"type": "object", "required": ["order", "scene_id", "asset_id", "image", "image_path", "duration", "transition", "narration", "caption"], "additionalProperties": false, "properties": {"order": {"type": "integer", "minimum": 1}, "scene_id": {"type": "string"}, "asset_id": {"type": "string"}, "image": {"type": "string", "description": "Bare filename (for backward compat with renderer)."}, "image_path": {"type": "string", "description": "Repo-relative POSIX path (resolves via repo_root)."}, "duration": {"type": "number", "minimum": 0.25}, "transition": {"type": "string", "enum": ["fade", "zoom", "slide", "none"]}, "narration": {"type": "string"}, "caption": {"type": "string"}}}}}