{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/video/asset_selection_report.schema.json",
  "title": "AssetSelectionReport",
  "description": "Deterministic, registry-backed asset selection evidence for one Director job.",
  "type": "object",
  "required": ["schema_version", "job_id", "storyboard_id", "selections"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "job_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "storyboard_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "selections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selection"}}
  },
  "$defs": {
    "selection": {
      "type": "object",
      "required": ["scene_id", "asset_id", "tags", "relative_path", "sha256", "source_type", "rights_basis", "classification", "fallback_used", "crop", "transformation"],
      "additionalProperties": false,
      "properties": {
        "scene_id": {"type": "string", "pattern": "^s\\d{2,}$"},
        "asset_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "relative_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\]+$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_type": {"type": "string", "enum": ["repository_owned", "deterministic_diagram", "licensed_library", "generated_original", "fallback"]},
        "rights_basis": {"type": "string", "minLength": 1, "maxLength": 240},
        "classification": {"type": "string", "enum": ["factual", "decorative"]},
        "fallback_used": {"type": "boolean"},
        "crop": {"type": "string", "maxLength": 120},
        "transformation": {"type": "string", "maxLength": 240}
      }
    }
  }
}
