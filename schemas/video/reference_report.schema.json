{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/video/reference_report.schema.json",
  "title": "LocalReferenceReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reference_id", "source_sha256", "duration_seconds", "resolution", "scenes", "style_fingerprint", "transcript", "asr"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "reference_id": {"type": "string", "pattern": "^ref_[a-f0-9]{16,64}$"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
    "resolution": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
    },
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scene_id", "start_seconds", "end_seconds", "duration_seconds", "representative_frame_time_seconds", "visual_description", "caption_summary", "audio_summary"],
        "properties": {
          "scene_id": {"type": "string", "pattern": "^s[0-9]{2,}$"},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "representative_frame_time_seconds": {"type": "number", "minimum": 0},
          "visual_description": {"type": "string", "minLength": 1, "maxLength": 240},
          "caption_summary": {"type": "string", "minLength": 1, "maxLength": 240},
          "audio_summary": {"type": "string", "minLength": 1, "maxLength": 240}
        }
      }
    },
    "style_fingerprint": {
      "type": "object", "additionalProperties": false,
      "required": ["pace", "shot_density_per_second", "median_shot_duration_seconds", "scene_count", "structure_summary"],
      "properties": {
        "pace": {"type": "string", "enum": ["fast", "medium", "slow"]},
        "shot_density_per_second": {"type": "number", "minimum": 0},
        "median_shot_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "scene_count": {"type": "integer", "minimum": 1},
        "structure_summary": {"type": "string", "enum": ["single_scene", "multi_scene"]}
      }
    },
    "transcript": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["start_seconds", "end_seconds", "text"],
        "properties": {
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "text": {"type": "string", "minLength": 1, "maxLength": 2000},
          "speaker": {"type": ["string", "null"], "maxLength": 120}
        }
      }
    },
    "asr": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "model", "reason"],
      "properties": {
        "status": {"type": "string", "enum": ["available", "unavailable", "not_requested"]},
        "model": {"type": ["string", "null"], "maxLength": 240},
        "reason": {"type": ["string", "null"], "maxLength": 240}
      }
    }
  }
}
