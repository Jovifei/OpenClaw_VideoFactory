{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/video/director_factual_brief.schema.json",
  "title": "DirectorFactualBrief",
  "description": "Small, source-linked factual input for an evergreen Director run. It stores metadata and claims, not copied source pages.",
  "type": "object",
  "required": ["schema_version", "topic_digest", "facts", "sources", "review_status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "topic_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fact_id", "claim", "source_ids"],
        "additionalProperties": false,
        "properties": {
          "fact_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "claim": {"type": "string", "minLength": 1, "maxLength": 600},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9_.-]+$"}, "uniqueItems": true}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["source_id", "title", "publisher", "url", "kind"],
        "additionalProperties": false,
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 240},
          "publisher": {"type": "string", "minLength": 1, "maxLength": 160},
          "url": {"type": "string", "format": "uri", "maxLength": 1000},
          "kind": {"type": "string", "enum": ["standard", "official_document", "vendor_document", "human_review"]},
          "published_date": {"type": ["string", "null"], "maxLength": 32}
        }
      }
    },
    "review_status": {"type": "string", "enum": ["unreviewed", "verified", "rejected"]}
  }
}
