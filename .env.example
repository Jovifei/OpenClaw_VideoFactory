DOUYIN_FACTORY_ROOT=E:\project\OpenClaw_VideoFactory
COMFYUI_URL=http://127.0.0.1:8188
CAPCUT_MATE_URL=http://127.0.0.1:30000
FACTORY_TIMEZONE=Asia/Shanghai
FACTORY_DAILY_LIMIT=1
FACTORY_TOPIC_TIME=08:30
FACTORY_AUTO_PRODUCE_TIME=12:00
FACTORY_MODEL_BUDGET_GB=30

# P0 bounded-trust media action tickets are disabled unless the local production
# environment deliberately opts in. The ticket service itself stays fail-closed.
# Optional one-process override. If absent, the ignored project-local
# config/local/media_ticket_execution.json setting is used. Both default closed.
MEDIA_TICKET_EXECUTION_ENABLED=0
OPENCLAW_MEDIA_ACTION_TICKET_TTL_SECONDS=300
OPENCLAW_MEDIA_ACTION_TICKET_NOT_BEFORE_SECONDS=1

# 不要提交真实 Token、Webhook 密钥、API Key。
# 飞书和模型供应商凭据使用 OpenClaw SecretRef 或经批准的本机秘密存储。
